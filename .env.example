# Copernicus Data Space Ecosystem (CDSE) Credentials
# Register for a free account at: https://dataspace.copernicus.eu/
# DO NOT commit the actual .env file with real credentials to GitHub.

CDSE_USERNAME=your_copernicus_email_or_username
CDSE_PASSWORD=your_copernicus_password

# Optional: OAuth2 Client Credentials (if using an OAuth Client instead of username/password)
# CDSE_CLIENT_ID=
# CDSE_CLIENT_SECRET=

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=1
